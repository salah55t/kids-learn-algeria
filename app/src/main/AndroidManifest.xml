<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحيات صوتيات TTS (لا حاجة لصلاحيات إضافية - TTS لا يتطلب Internet) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Vibrator للتغذية الراجعة اللمسية عند كتابة حرف -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsLearn"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.KidsLearn.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- نشاطات الأقسام -->
        <activity
            android:name=".ui.letters.ArabicLettersActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.letters.EnglishLettersActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.letters.LetterDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.numbers.NumbersActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.colors.ColorsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.shapes.ShapesActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.animals.AnimalsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- نشاط الإنجازات/الملصقات -->
        <activity
            android:name=".ui.main.AchievementsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
    </application>

</manifest>
